# Kopier til .env og fyll inn verdiene fra Supabase Dashboard
# Project Settings → API

VITE_SUPABASE_URL=https://ditt-prosjekt.supabase.co
VITE_SUPABASE_ANON_KEY=din-anon-key

# For migreringer (npm run db:push) - hent fra Project Settings
# SUPABASE_PROJECT_REF = prosjekt-ID fra dashboard-URL (https://supabase.com/dashboard/project/<denne>)
# SUPABASE_DB_PASSWORD = database-passord du satte ved opprettelse
